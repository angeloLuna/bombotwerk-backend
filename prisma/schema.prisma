generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Core Models ----------
model Product {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String?
  price       Decimal         @default(0)
  category    String?
  isActive    Boolean         @default(true)
  isNewArrival Boolean        @default(false)
  isFeatured  Boolean         @default(false)
  compareAtPrice Decimal?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  collection  Collection?    @relation(fields: [collectionId], references: [id])
  collectionId String?
  variants    ProductVariant[]
  media       ProductMedia[]
  images      ProductImage[]
  orderItems  OrderItem[]     @relation("ProductOrderItems")

  // SEO fields
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  canonicalSlug  String?
}

model ProductVariant {
  id                 String        @id @default(cuid())
  sku                String        @unique
  color              String?
  colorHex           String?
  availabilityMode   String        @default("stock_only") // stock_only, stock_and_made_to_order, made_to_order_only, discontinued
  madeToOrderMinDays Int?          @default(7)
  madeToOrderMaxDays Int?          @default(9)
  product            Product       @relation(fields: [productId], references: [id])
  productId          String
  stocks             SizeStock[]
  orderItems         OrderItem[]   @relation("VariantOrderItems")
  images             VariantImage[]
}

// ---------- Inventory ----------
model SizeStock {
  id          String        @id @default(cuid())
  size        String        // e.g., S, M, L, OS
  quantity    Int           @default(0)
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  variantId   String
}

model VariantImage {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url       String
  key       String?
  altText   String?
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([variantId])
}

// ---------- Collections & Media ----------
model Collection {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  tagline     String?
  description String?
  bgImage     String?
  coverImageUrl String?
  heroImageUrl  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  products    Product[]
  isActive    Boolean    @default(true)
  sortOrder     Int        @default(0)

  // SEO fields
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  imageAltText   String?
}

model ProductMedia {
  id        String   @id @default(cuid())
  url       String
  altText   String?
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id])
  productId String
}

// ---------- Customers ----------
model Customer {
  id      String   @id @default(cuid())
  email   String   @unique
  name    String?
  phone   String?
  orders  Order[]
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId  String?
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  image     String?
  role      String     @default("customer") // admin | customer
  provider  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  customers Customer[]
  orders    Order[]
  activityLogs ActivityLog[]
  auditLogs    AuditLog[]
  orderNotes   OrderNote[]
}


// ---------- Orders & Payments ----------
model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId      String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId          String?
  guestEmail      String?
  customerName    String?     // Guest/Customer Name snapshot
  customerEmail   String      // Guest/Customer Email snapshot
  customerPhone   String?     // Guest/Customer Phone snapshot
  shippingAddress String?
  
  // Email confirmation control fields
  confirmationEmailSentAt DateTime?
  confirmationEmailStatus String?   // e.g., 'sending', 'sent', 'failed'
  confirmationEmailError  String?
  billingAddress  String?
  shippingMethod  String?
  subtotal        Decimal     @default(0)
  shippingTotal   Decimal     @default(0)
  total           Decimal     @default(0)
  currency        String      @default("MXN")
  status          String      @default("pending") // pending, paid, failed, cancelled
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[] @relation("OrderItems")
  payment         Payment?

  // --- Shipping snapshot fields ---
  shippingLabel                        String?   @default("Envío estándar")
  shippingCost                         Decimal   @default(0)
  isFreeShipping                       Boolean   @default(false)
  freeShippingThreshold                Decimal   @default(1000)
  amountRemainingForFreeShipping       Decimal   @default(0)
  hasInStockItems                      Boolean   @default(false)
  hasMadeToOrderItems                  Boolean   @default(false)
  isMixedFulfillmentCart               Boolean   @default(false)
  splitShippingSelected                Boolean   @default(false)
  splitShippingCost                    Decimal   @default(0)
  estimatedDeliveryMinBusinessDays     Int?
  estimatedDeliveryMaxBusinessDays     Int?
  firstPackageEstimatedMinBusinessDays  Int?
  firstPackageEstimatedMaxBusinessDays  Int?
  secondPackageEstimatedMinBusinessDays Int?
  secondPackageEstimatedMaxBusinessDays Int?
  fulfillmentNotes                     String?
  shippingNotes                        String?
  fulfillmentStatus                    String      @default("pending_review")
  carrier                              String?
  trackingNumber                       String?
  trackingUrl                          String?
  shippedAt                            DateTime?
  deliveredAt                          DateTime?
  notes                                OrderNote[]
}

model OrderItem {
  id                 String          @id @default(cuid())
  order              Order           @relation("OrderItems", fields: [orderId], references: [id], onDelete: Cascade)
  orderId            String
  product            Product?        @relation("ProductOrderItems", fields: [productId], references: [id], onDelete: SetNull)
  productId          String?
  variant            ProductVariant? @relation("VariantOrderItems", fields: [variantId], references: [id], onDelete: SetNull)
  variantId          String?
  productName        String?         // Historical snapshot of the product name
  variantName        String?         // Historical snapshot of the variant (e.g. "Color / Size")
  size               String          // size from SizeStock
  quantity           Int             @default(1)
  unitPrice          Decimal         @default(0)
  total              Decimal         @default(0)
  fulfillmentType    String          @default("stock") // "stock" | "made_to_order"
  madeToOrderMinDays Int?
  madeToOrderMaxDays Int?
}

model Payment {
  id                String   @id @default(cuid())
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId           String   @unique
  provider          String   @default("mercadopago")
  providerPaymentId String?  @unique
  providerStatus    String?  // Mercado Pago's native status (e.g., approved, rejected, pending)
  status            String   @default("pending") // internal status: pending, approved, rejected, in_process, cancelled
  amount            Decimal  @default(0)
  currency          String   @default("MXN")
  paymentMethod     String?  // E.g., Visa, MasterCard, Oxxo
  rawResponse       Json?    // Raw JSON from provider
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Backward compatibility fields
  method            String?
  transactionId     String?
  statusDetail      String?
}

model ProductImage {
  id        String           @id @default(cuid())
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  key       String?
  alt       String?
  type      ProductImageType @default(catalog)
  view      ProductImageView @default(not_applicable)
  sortOrder Int              @default(0)
  isCover   Boolean          @default(false)

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([productId])
}

enum ProductImageType {
  catalog
  editorial
  detail
  technical
  styling
  community
}

enum ProductImageView {
  front
  back
  side
  detail
  not_applicable
}

model Redirect {
  id          String   @id @default(cuid())
  source      String   @unique
  destination String
  statusCode  Int      @default(301)
  createdAt   DateTime @default(now())
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestEmail  String?
  orderId     String?
  productId   String?
  eventType   String
  metadata    Json     @default("{}")
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([guestEmail])
  @@index([eventType])
}

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  adminUser   User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([adminUserId])
  @@index([action])
  @@index([entityType, entityId])
}

model OrderNote {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminUserId String?
  adminUser   User?     @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  content     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orderId])
  @@index([adminUserId])
}

model ProductTypeCard {
  id          String   @id @default(cuid())
  title       String
  slug        String
  description String?
  imageUrl    String
  imageAlt    String?
  badgeLabel  String?
  badgeType   String?
  href        String
  linkType    String   @default("category") // collection, category, search, offer, external
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  highlight   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
