# ---------- NestJS App Environment ----------
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://bombo-twerk-frontend.vercel.app

# ---------- PostgreSQL Database Settings ----------
POSTGRES_USER=bombotwerk_prod_user
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=bombotwerk_prod

# DATABASE_URL for Docker network - points to internal 'postgres' host
DATABASE_URL=postgresql://bombotwerk_prod_user:your_secure_db_password_here@postgres:5432/bombotwerk_prod?schema=public

# ---------- Authentication ----------
BACKEND_JWT_SECRET=your_production_secure_jwt_secret_here
ADMIN_EMAILS=angel.luna.najera@gmail.com,admin@bombotwerk.com

# ---------- Mercado Pago Pasarela ----------
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxx-xxxx-xxxx
MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxx-xxxx-xxxx

# ---------- Cloudflare R2 / AWS S3 Storage ----------
R2_ACCOUNT_ID=your_r2_account_id
R2_ENDPOINT=https://your_r2_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=bombotwerk-prod
R2_PUBLIC_BASE_URL=https://cdn.bombotwerk.com

# ---------- Email Provider (Resend SMTP) ----------
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USER=resend
EMAIL_PASSWORD=re_your_resend_api_key_here
EMAIL_FROM="Bombo Twerk <ventas@bombotwerk.com>"
